# Copy to .env.local for `npm run dev`.

# Public Supabase client (safe to expose — access is gated by RLS)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Backend API base — where the Flask/Modal backend from the repo root is deployed
NEXT_PUBLIC_API_BASE=http://localhost:5000

# Used by next.config.mjs to proxy /api/* server-side (build/server-only, no NEXT_PUBLIC_ prefix)
MODAL_BACKEND_URL=http://localhost:5000

# Optional — PostHog project key. Analytics init is skipped entirely if unset.
NEXT_PUBLIC_POSTHOG_KEY=
